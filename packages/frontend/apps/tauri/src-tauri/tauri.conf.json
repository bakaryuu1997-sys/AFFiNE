{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AFFiNE Ca nhan",
  "version": "0.2.1",
  "identifier": "dev.bakaryuu.affine-personal",
  "build": {
    "frontendDist": "../web-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AFFiNE v0.2.1",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 600,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
